{
  "schema_version": 2,
  "project_id": "pixel_sprite_demo",
  "label": "Pixel Sprite Demo",
  "roots": {
    "project": "."
  },
  "storage": ".artflow-state",
  "pipelines": "pipelines.json",
  "executors": {
    "python": {
      "argv": [
        "{python}",
        "{root.project}/make_asset.py"
      ],
      "cwd": "{root.project}",
      "allowed_commands": [
        [
          "build",
          "{artifact.recipe}",
          "{artifact.image}"
        ],
        [
          "verify",
          "{artifact.image}"
        ]
      ],
      "version_files": [
        "{root.project}/make_asset.py"
      ],
      "response": {
        "format": "exit_code"
      }
    }
  },
  "templates": {
    "sprite": {
      "kind": "Pixel Sprite",
      "pipeline": "sprite",
      "metadata": {
        "Canvas": [64, 64],
        "Scale": 4,
        "Format": "hard-alpha RGBA PNG"
      },
      "artifacts": {
        "recipe": {
          "label": "Sprite Recipe",
          "kind": "json",
          "path": "inputs/{asset_id}.json"
        },
        "image": {
          "label": "Runtime PNG",
          "kind": "image",
          "path": "output/{asset_id}.png"
        }
      },
      "preview": [
        "image"
      ]
    }
  },
  "assets": {
    "campfire": {
      "template": "sprite",
      "label": "Campfire"
    },
    "crystal": {
      "template": "sprite",
      "label": "Crystal"
    }
  }
}
