{
  "schema_version": 2,
  "pipelines": {
    "sprite": {
      "label": "Pixel Sprite Production",
      "steps": [
        {
          "id": "build",
          "label": "Build PNG",
          "description": "Turn the JSON pixel recipe into a transparent runtime PNG.",
          "kind": "command",
          "executor": "python",
          "command": [
            "build",
            "{artifact.recipe}",
            "{artifact.image}"
          ],
          "inputs": [
            "recipe"
          ],
          "outputs": [
            "image"
          ],
          "writes": true,
          "requires_approval": true,
          "approval_artifacts": [
            "recipe"
          ],
          "timeout_seconds": 30,
          "retry_policy": "manual",
          "locks": [
            "asset:{project_id}:{asset_id}"
          ]
        },
        {
          "id": "verify",
          "label": "Verify PNG",
          "description": "Check PNG chunks, CRC values, RGBA format and transparency.",
          "kind": "command",
          "executor": "python",
          "command": [
            "verify",
            "{artifact.image}"
          ],
          "inputs": [
            "image"
          ],
          "outputs": [],
          "depends_on": [
            "build"
          ],
          "writes": false,
          "timeout_seconds": 10,
          "retry_policy": "safe",
          "locks": []
        }
      ],
      "actions": {
        "build": {
          "label": "Build and verify",
          "steps": [
            "build",
            "verify"
          ],
          "publish_artifacts": [
            "image",
            "recipe"
          ],
          "description": "Build the PNG from the reviewed recipe, then verify the result."
        },
        "verify": {
          "label": "Verify existing PNG",
          "steps": [
            "verify"
          ],
          "publish_artifacts": [
            "image"
          ],
          "description": "Verify the current PNG without rebuilding it."
        }
      }
    }
  }
}
